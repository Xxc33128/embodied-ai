class ResizeImages(DataTransformFn):
    height: int
    width: int

    def __call__(self, data: DataDict) -> DataDict:
        # gap-repro patch (W6): JAX 链路上游存在 HWC→CHW 转置（torch 迁移残留），
        # PIL resize 需要 HWC；检测 (1,3)-首轴通道并转回。原件未改动（我们自己的副本）。
        def _as_hwc(v):
            import numpy as _np
            v = _np.asarray(v)
            if v.ndim == 3 and v.shape[0] in (1, 3) and v.shape[-1] != 3:
                v = _np.transpose(v, (1, 2, 0))
            return v
        data["image"] = {k: image_tools.resize_with_pad(_as_hwc(v), self.height, self.width) for k, v in data["image"].items()}
        return data

